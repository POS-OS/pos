# Settings of ./build. Copy to ~/.config/pos/build.conf, or another file
# named by POS_BUILD_CONFIG, and edit. Lines are "<key> <value>"; the
# environment variable named with each setting overrides it. Only new
# builds read settings: a build records what it uses in its info.

# Fedora release of the build tools, and so of the RPM packages
# (POS_FEDORA_RELEASE).
#fedora-release 44

# Image the build tools are installed on (POS_TOOLS_IMAGE). Default:
# registry.fedoraproject.org/fedora:<release>.
#tools-image registry.fedoraproject.org/fedora:44

# Directory of reference builds (POS_REFERENCE_DIR), the toolchain builds
# ./build reference stores. No default: without it, only a toolchain build
# can be made, with Fedora's compiler.
#reference-dir /path/to/pos-references

# Reference build a new build takes the toolchain from (POS_REFERENCE): a
# build ID in reference-dir, or none for a toolchain build with Fedora's
# compiler. Default: the one ./build reference marked last.
#reference none

# Release library (POS_RELEASE_DIR): ./build publish copies a numbered
# build's artifacts into <release-dir>/<release>; publish reads it, builds
# do not record it. No default: publish needs it.
#release-dir /path/to/pos-releases
