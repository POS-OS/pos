# Built by the build's compiler: the toolchain reference's gcc, which
# runs on the pos reference's glibc until this one is built, or gcc-host
# (with host-linux-headers) in the bootstrap build without one.
# No pos-link: glibc links its new libc by path from the build tree, and
# the search path pos-link adds would reach it (BUILD.md "Core libs stage").
build-requires gcc linux-headers
