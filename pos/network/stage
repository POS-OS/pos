# Network tools: an optional stage. It ships with an installation as a
# system extension image and is enabled with pos-stage (BUILD.md "Network
# stage").
# Netlink libraries: libmnl for iproute2, ethtool and nftables; libnftnl
# for nftables.
libmnl
libnftnl
# Links, addresses, routes, sockets (ip, ss, bridge, tc).
iproute2
# ICMP diagnostics: ping, tracepath, arping, clockdiff.
iputils
# Wired device settings: link speed, offloads.
ethtool
# Packet filtering; jansson for its JSON mode.
jansson
nftables
# Transfer: wget2, rsync (curl is the base's).
wget2
rsync
# Remote shell: ssh, sshd, scp, sftp.
openssh
