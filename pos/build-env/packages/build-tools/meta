# Build profile: the build tools of every step when the tools setting
# names an extras reference (BUILD.md "Build tools"), in place of
# host-base: the base stage's tools from the pos reference, the rest
# pos-extras', in its prefix. A package's own requirements come first; a
# tool it does not require is the references' copy.
kind profile
requires bash coreutils findutils gawk grep sed tar gzip xz zstd bzip2 cpio file which curl
requires make m4 autoconf automake autoconf-archive libtool pkgconf
requires bison flex gperf texinfo help2man gettext-tools
requires perl python3 git diffutils patch patchelf
# Python modules of recipes' build steps (systemd's meson, qemu's
# configure venv), in place of their Fedora host-requires.
requires python3-setuptools python3-wheel python3-jinja2 python3-pyyaml
requires python3-pyelftools
# meson, ninja and cmake: the build systems recipes build with.
requires meson ninja cmake
# wget: gnulib bootstrap fetches translations with it.
requires wget2
# Man page tools: groff (gettext, less), asciidoctor (util-linux,
# cryptsetup), man-db (podman checks its pages with man -l).
requires groff asciidoctor man-db
# Code generators of the container packages: go-md2man (their man pages,
# from Markdown), protoc (netavark's DHCP proxy, gRPC).
requires go-md2man protobuf
