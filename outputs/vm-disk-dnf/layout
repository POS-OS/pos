# What vm-disk-dnf's root has before dnf installs into it (fs_layout in
# buildsys/output-plugins.d/fs.sh); the rest of its layout is Fedora's
# filesystem package's. As in vm-disk, /usr/lib/modules links out of /usr
# to pos-kernel's modules directory, and rpm installs the kernel's
# modules through the link (BUILD.md "Kernels").
#
#   dir <path> <mode>        directory
#   link <path> <target>     symlink

dir /usr/lib 0755
dir /var/lib/pos/kernel/modules 0755
link /usr/lib/modules ../../var/lib/pos/kernel/modules
